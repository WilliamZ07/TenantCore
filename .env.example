ENVIRONMENT=development
PROJECT_NAME="Multi-Tenant SaaS Infrastructure"
DEBUG=True

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saas_db

# Superuser (for running Alembic migrations)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret

# Non-superuser runtime role (enforced by RLS)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_secret

REDIS_HOST=localhost
REDIS_PORT=6379