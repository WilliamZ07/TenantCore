# ==============================================================================
# TenantCore Configuration Environment Variables
# ==============================================================================

# Application Runtime
ENVIRONMENT=development
DEBUG=True
APP_NAME=TenantCore
API_V1_STR=/api/v1
WEB_CONCURRENCY=4

# Database Administrative Role (Used exclusively for Alembic DDL migrations)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=saas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret

# Application Runtime Role (Unprivileged role subject to PostgreSQL RLS)
APP_DB_USER=app_user
APP_DB_PASSWORD=app_secret

# Redis Cache, Rate Limiting & Arq Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security & Webhook Signatures (HMAC-SHA256)
WEBHOOK_SECRET=whsec_test_secret_key_998877

# Rate Limiter Controls (Sliding Window via Redis Lua)
RATE_LIMIT_REQUESTS_PER_MINUTE=100